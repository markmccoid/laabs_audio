+// LOCAL PATCH (laabs_audio): UIKit drives tabBarMinimizeBehavior (iOS 26) off the
+// scroll view returned by contentScrollViewForEdge:. The default UIViewController
+// implementation cannot find React Native scroll views through the nested
+// stack hierarchy, so the tab bar never minimizes and the bottom accessory never
+// enters the inline environment. BFS the subtree so the shallowest (main vertical)
+// scroll view wins over nested horizontal shelves.
+// See https://github.com/callstack/react-native-bottom-tabs/issues/496
+- (nullable UIScrollView *)rns_findDescendantScrollViewInView:(UIView *)view
+{
+  NSMutableArray<UIView *> *queue = [view.subviews mutableCopy];
+  NSUInteger index = 0;
+  while (index < queue.count) {
+    UIView *current = queue[index++];
+    if ([current isKindOfClass:UIScrollView.class]) {
+      return static_cast<UIScrollView *>(current);
+    }
+    [queue addObjectsFromArray:current.subviews];
+  }
+  return nil;
+}
+
+- (nullable UIScrollView *)contentScrollViewForEdge:(NSDirectionalRectEdge)edge
+{
+  if (@available(iOS 15.0, *)) {
+    UIScrollView *scrollView = [super contentScrollViewForEdge:edge];
+    if (scrollView != nil) {
+      return scrollView;
+    }
+  }
+  if ((edge & NSDirectionalRectEdgeBottom) != 0) {
+    return [self rns_findDescendantScrollViewInView:self.view];
+  }
+  return nil;
+}
