+
+// LAABS: see WidgetUserInteraction.perform().
+private let laabsPendingPlayKey = "LAABSPendingWidgetPlayRequestAt"
+
+/// Returns the props change for a LAABS play/pause tap, or nil for any other button.
+private func laabsOptimisticPlaybackProps(props: [String: Any], target: String?) -> [String: Any]? {
+  let state: String
+  switch target {
+  case "laabs.audio.play": state = "playing"
+  case "laabs.audio.pause": state = "paused"
+  default: return nil
+  }
+  guard var media = props["media"] as? [String: Any],
+        var playback = media["playback"] as? [String: Any] else {
+    return nil
+  }
+  playback["state"] = state
+  playback["anchorTimestampMs"] = Date().timeIntervalSince1970 * 1000
+  media["playback"] = playback
+  return ["media": media]
+}
