{
  "expo": {
    "name": "LAABS Audiobookshelf",
    "slug": "laabs_audio",
    "version": "1.5.8",
    "orientation": "portrait",
    "scheme": "laabsaudio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "usesIcloudStorage": true,
      "icon": "./assets/laabs-abs.icon",
      "bundleIdentifier": "com.markmccoid.laabs-audio",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false,
        "RCTAsyncStorageExcludeFromBackup": false,
        "NSSpeechRecognitionUsageDescription": "LAABS Audio uses speech recognition to transcribe saved audiobook clips when you request a clip transcription.",
        "NSMicrophoneUsageDescription": "While this app does not use the microphone, the APIs used to play audio still have access to the microphone.  The app will not however ever use the microphone on your device.",
        "NSPhotoLibraryUsageDescription": "LAABS Audio uses image-loading APIs that can access photo-library assets if you choose one as artwork.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.markmccoid.laabsaudio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F9F84",
          "image": "./assets/laabs-splash.png",
          "resizeMode": "cover",
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-asset",
      "expo-audio",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      "./plugins/with-carplay"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": ["src/native"]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79a00c8a-7da4-4da1-a741-4c17c85108ea"
      }
    }
  }
}
